# ============================================================
#  2조 SOL로몬 — 백엔드 환경변수 예시
#
#  이 파일을 BackEnd/.env 로 복사한 뒤 값을 채우세요.
#      copy deploy\.env.example BackEnd\.env
#
#  아래 값은 deploy/docker-compose.yml 로 실행하는
#  '독립 실행' 기준입니다. 컨테이너 이름으로 서로를 찾습니다.
# ============================================================

# ── PostgreSQL (컨테이너로 함께 뜸) ──────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=chatbot
DB_NAME=school_chatbot

# ── Qdrant (컨테이너로 함께 뜸) ──────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
HYBRID_SEARCH=true

# ── 인증 ─────────────────────────────────────────────────────
# 아무 긴 문자열이면 됩니다. 아래 명령으로 생성 가능:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=여기에_임의의_긴_문자열을_넣으세요

# ── 답변 생성 LLM ────────────────────────────────────────────
# local  : BackEnd/llm 의 GGUF 모델을 GPU에서 직접 구동 (외부 키 불필요)
# vertex : Google Vertex AI (Gemini). gcp-sa.json 서비스계정 키가 필요합니다.
LLM_PROVIDER=local
MODEL_PATH=./llm/llama-3-Korean-Bllossom-8B-Q4_K_M.gguf
DEVICE=cuda

# VRAM에 맞춰 조정하세요.
#   RTX 3070(8GB)  → 25 / 4096   (기본값)
#   RTX 4090·5090  → -1 / 8192   (-1 = 전 레이어 GPU)
LLM_GPU_LAYERS=25
LLM_N_CTX=4096

# ── 임베딩 · 리랭커 ──────────────────────────────────────────
# BGE-M3는 첫 실행 시 HuggingFace에서 자동으로 내려받습니다(약 2.3GB).
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_PROVIDER=local
EMBEDDING_DEVICE=cuda
RERANKER_DEVICE=cuda
# 경로는 docker-compose.yml 에서 지정하므로 보통 건드리지 않습니다.
RERANKER_MODEL_PATH=/app/models/bge-reranker-v2-m3-ko

# ── 프론트엔드 ───────────────────────────────────────────────
FRONTEND_ORIGINS=http://localhost:5173
VITE_SHOW_DEV_TOOLS=false

# ── 기타 ─────────────────────────────────────────────────────
CRAWL_CHUNK_SIZE=1500
RATE_LIMIT_ENABLED=true
CHAT_RATE_LIMIT=20
RATE_LIMIT_WINDOW=60
# true 로 두면 LLM 로딩을 건너뜁니다(로그인·DB만 테스트할 때).
DEV_MODE=false


# ============================================================
#  선택 기능 — 없어도 나머지는 정상 동작합니다
# ============================================================

# ── 날씨 (캠퍼스 날씨 카드) ──────────────────────────────────
# https://openweathermap.org 무료 가입 후 발급. 키 활성화까지 최대 2시간.
OPENWEATHER_API_KEY=

# ── 지도 (캠퍼스 길안내) ─────────────────────────────────────
# https://developers.kakao.com 에서 발급
KAKAO_API_KEY=

# ── Vertex AI (LLM_PROVIDER=vertex 이거나 다국어를 쓸 때만) ──
# 다국어 번역이 Google Cloud Translation을 사용하므로,
# 이 값이 없으면 한국어만 동작합니다.
GOOGLE_APPLICATION_CREDENTIALS=/app/gcp-sa.json
GEMINI_MODEL=gemini-2.0-flash-001
GCP_PROJECT_ID=
GCP_LOCATION=global
